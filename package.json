{
  "name": "it-magazine-frontend",
  "private": true,
  "description": "Builds Tailwind CSS and vendors frontend assets into static/ for Django.",
  "scripts": {
    "build:css": "tailwindcss -i assets/tailwind.css -o static/css/tailwind.css --minify",
    "watch:css": "tailwindcss -i assets/tailwind.css -o static/css/tailwind.css --watch",
    "vendor": "node scripts/vendor.mjs",
    "build": "npm run vendor && npm run build:css"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "htmx.org": "2.0.4",
    "tailwindcss": "^3.4.17",
    "vazirmatn": "^33.0.3"
  }
}
