# --- Core ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=False
DOMAIN=academy.example.com
DJANGO_ALLOWED_HOSTS=academy.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://academy.example.com
SITE_URL=https://academy.example.com

# --- Database / cache ---
POSTGRES_DB=itacademy
POSTGRES_USER=itacademy
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://itacademy:change-me@db:5432/itacademy
REDIS_URL=redis://redis:6379/0

# --- Link to the IT Magazine (sister site) ---
# Leave MAGAZINE_URL empty to switch the link off (no magazine links, boxes or API calls).
MAGAZINE_URL=https://magazine.example.com
# Defaults to MAGAZINE_URL + /api
MAGAZINE_API_URL=
MAGAZINE_NAME=مجله فناوری
# Origins allowed to call this site's /api/ from a browser (default: MAGAZINE_URL)
API_CORS_ALLOWED_ORIGINS=https://magazine.example.com

# --- Email (SMTP). Without EMAIL_HOST emails are printed to the console. ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=آموزشگاه فناوری <no-reply@example.com>
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Social login (leave empty to hide the button) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Security ---
ADMIN_URL=admin/
ADMIN_REQUIRE_MFA=True
MAX_IMAGE_UPLOAD_MB=10

# --- Error reporting ---
DJANGO_ADMINS=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0

MAINTENANCE_MODE=False

# Student-only lesson files (outside MEDIA_ROOT). Mount a persistent volume here in production.
PRIVATE_MEDIA_ROOT=/app/private_media
MAX_SUBMISSION_MB=10
MAX_VIDEO_UPLOAD_MB=300
